# ===== 元宝搜索（腾讯云 wsa）=====
# 控制台：https://console.cloud.tencent.com/wsapi
# 密钥：  https://console.cloud.tencent.com/cam/capi （SecretKey 只显示一次）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ===== 大模型（OpenAI 兼容；只用于拆句与立场标签，不下结论）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 运行模式 auto=有密钥走真实接口、失败自动降级演示数据 =====
RUN_MODE=auto

# ===== 署名（卡片上会显示）=====
OWNER_NAME=曾艳
OWNER_TAGLINE=帮小微企业把 AI 用起来
OWNER_WECHAT=
# 发布到公网后填这里，二维码会指向它
PUBLIC_BASE_URL=

# ===== 限额（下面三个与 detective/config.py 的默认值一致，可不动）=====
RATE_LIMIT_PER_HOUR=30
MAX_SEARCH_PER_INVESTIGATION=9   # 单句核查最多检索次数
MAX_ROUNDS=3                     # 核查轮数
CHECKUP_TOP_N=8                  # 体检深查句数上限
CHECKUP_TIME_BUDGET=55           # 体检总时间预算（秒）
