# ===== 元宝搜索（腾讯云 wsa）=====
# 控制台：https://console.cloud.tencent.com/wsapi
# 密钥：  https://console.cloud.tencent.com/cam/capi （SecretKey 只显示一次）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ===== 大模型（OpenAI 兼容；只用于拆句与立场标签，不下结论）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 运行模式 auto=有密钥走真实接口、失败自动降级演示数据 =====
RUN_MODE=auto

# ===== 署名（卡片上会显示，入门砖的关键）=====
OWNER_NAME=曾燕
OWNER_TAGLINE=帮小微企业把 AI 用起来
OWNER_WECHAT=
# 发布到公网后填这里，二维码会指向它
PUBLIC_BASE_URL=

# ===== 限额 =====
RATE_LIMIT_PER_HOUR=30
MAX_SEARCH_PER_INVESTIGATION=7
MAX_ROUNDS=3
CHECKUP_TOP_N=5
